{
  "name": "a3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "description": "A^3 – Autonomous Agent Assistant",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm --filter @a3/desktop build",
    "check:links": "node scripts/check-markdown-links.mjs",
    "ci:frontend": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "pnpm --filter @a3/desktop format && pnpm --filter @a3/desktop exec prettier --write ../../scripts ../../.github/workflows/ci.yml ../../eslint.config.js ../../package.json",
    "format:check": "pnpm --filter @a3/desktop format:check && pnpm --filter @a3/desktop exec prettier --check ../../scripts ../../.github/workflows/ci.yml ../../eslint.config.js ../../package.json",
    "lint": "pnpm --filter @a3/desktop lint && node apps/desktop/node_modules/eslint/bin/eslint.js --config eslint.config.js scripts --max-warnings 0",
    "report:dependencies": "node scripts/generate-dependency-report.mjs",
    "tauri": "pnpm --filter @a3/desktop tauri",
    "test": "pnpm --filter @a3/desktop test && pnpm test:tools",
    "test:tools": "node --test scripts/*.test.mjs",
    "typecheck": "pnpm --filter @a3/desktop typecheck"
  },
  "engines": {
    "node": "24.14.0",
    "pnpm": "11.9.0"
  }
}
