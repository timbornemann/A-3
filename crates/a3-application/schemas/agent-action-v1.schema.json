{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a3.local/schemas/agent-action-v1.schema.json",
  "title": "A^3 AgentAction V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "action"],
  "properties": {
    "schema_version": { "const": 1 },
    "action": {
      "oneOf": [
        { "$ref": "#/$defs/search" },
        { "$ref": "#/$defs/inspect" },
        { "$ref": "#/$defs/updateLedger" },
        { "$ref": "#/$defs/finish" }
      ]
    }
  },
  "$defs": {
    "hexId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "query", "limit"],
      "properties": {
        "kind": { "const": "search" },
        "query": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "inspect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target"],
      "properties": {
        "kind": { "const": "inspect" },
        "target": {
          "oneOf": [
            { "$ref": "#/$defs/fileTarget" },
            { "$ref": "#/$defs/symbolTarget" },
            { "$ref": "#/$defs/graphTarget" },
            { "$ref": "#/$defs/claimTarget" },
            { "$ref": "#/$defs/testTarget" }
          ]
        }
      }
    },
    "fileTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "start_line", "line_count"],
      "properties": {
        "kind": { "const": "file" },
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "start_line": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "line_count": { "type": "integer", "minimum": 1, "maximum": 500 }
      }
    },
    "symbolTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "symbol_id"],
      "properties": {
        "kind": { "const": "symbol" },
        "symbol_id": { "$ref": "#/$defs/hexId" }
      }
    },
    "graphTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "symbol_id", "direction", "relation", "depth", "limit"],
      "properties": {
        "kind": { "const": "graph" },
        "symbol_id": { "$ref": "#/$defs/hexId" },
        "direction": { "enum": ["outgoing", "incoming"] },
        "relation": { "enum": ["imports", "exports", "calls", "tests"] },
        "depth": { "type": "integer", "minimum": 1, "maximum": 2 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "claimTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "claim_id"],
      "properties": {
        "kind": { "const": "claim" },
        "claim_id": { "$ref": "#/$defs/hexId" }
      }
    },
    "testTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "selector"],
      "properties": {
        "kind": { "const": "test" },
        "selector": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "updateLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "step_id", "update"],
      "properties": {
        "kind": { "const": "update_ledger" },
        "step_id": { "$ref": "#/$defs/hexId" },
        "update": {
          "oneOf": [
            { "$ref": "#/$defs/recordResult" },
            { "$ref": "#/$defs/reportBlocked" },
            { "$ref": "#/$defs/requestReplan" }
          ]
        }
      }
    },
    "recordResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "summary"],
      "properties": {
        "kind": { "const": "record_result" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 8192 }
      }
    },
    "reportBlocked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": {
        "kind": { "const": "report_blocked" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "requestReplan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": {
        "kind": { "const": "request_replan" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "finish": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "finish" }
      }
    }
  }
}
