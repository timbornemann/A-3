{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a3.local/schemas/agent-action-v6.schema.json",
  "title": "A^3 AgentAction V6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action"
  ],
  "properties": {
    "schema_version": {
      "const": 6
    },
    "action": {
      "oneOf": [
        {
          "$ref": "#/$defs/search"
        },
        {
          "$ref": "#/$defs/inspect"
        },
        {
          "$ref": "#/$defs/updateLedger"
        },
        {
          "$ref": "#/$defs/finish"
        },
        {
          "$ref": "#/$defs/applyPatch"
        },
        {
          "$ref": "#/$defs/run"
        },
        {
          "$ref": "#/$defs/machine"
        }
      ]
    }
  },
  "$defs": {
    "hexId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "query",
        "limit"
      ],
      "properties": {
        "kind": {
          "const": "search"
        },
        "query": {
          "$ref": "#/$defs/path"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "inspect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target"
      ],
      "properties": {
        "kind": {
          "const": "inspect"
        },
        "target": {
          "oneOf": [
            {
              "$ref": "#/$defs/fileTarget"
            },
            {
              "$ref": "#/$defs/symbolTarget"
            },
            {
              "$ref": "#/$defs/graphTarget"
            },
            {
              "$ref": "#/$defs/claimTarget"
            },
            {
              "$ref": "#/$defs/testTarget"
            },
            {
              "$ref": "#/$defs/functionFlowTarget"
            }
          ]
        }
      }
    },
    "fileTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "start_line",
        "line_count"
      ],
      "properties": {
        "kind": {
          "const": "file"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "line_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      }
    },
    "symbolTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "symbol_id"
      ],
      "properties": {
        "kind": {
          "const": "symbol"
        },
        "symbol_id": {
          "$ref": "#/$defs/hexId"
        }
      }
    },
    "graphTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "symbol_id",
        "direction",
        "relation",
        "depth",
        "limit"
      ],
      "properties": {
        "kind": {
          "const": "graph"
        },
        "symbol_id": {
          "$ref": "#/$defs/hexId"
        },
        "direction": {
          "enum": [
            "outgoing",
            "incoming"
          ]
        },
        "relation": {
          "enum": [
            "imports",
            "exports",
            "calls",
            "tests"
          ]
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "claimTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "claim_id"
      ],
      "properties": {
        "kind": {
          "const": "claim"
        },
        "claim_id": {
          "$ref": "#/$defs/hexId"
        }
      }
    },
    "testTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "selector"
      ],
      "properties": {
        "kind": {
          "const": "test"
        },
        "selector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "updateLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "step_id",
        "update"
      ],
      "properties": {
        "kind": {
          "const": "update_ledger"
        },
        "step_id": {
          "$ref": "#/$defs/stepId"
        },
        "update": {
          "oneOf": [
            {
              "$ref": "#/$defs/recordResult"
            },
            {
              "$ref": "#/$defs/reportBlocked"
            },
            {
              "$ref": "#/$defs/requestReplan"
            }
          ]
        }
      }
    },
    "recordResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "summary"
      ],
      "properties": {
        "kind": {
          "const": "record_result"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      }
    },
    "reportBlocked": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reason"
      ],
      "properties": {
        "kind": {
          "const": "report_blocked"
        },
        "reason": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "requestReplan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reason"
      ],
      "properties": {
        "kind": {
          "const": "request_replan"
        },
        "reason": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "finish": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "finish"
        }
      }
    },
    "applyPatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "run_id",
        "worktree_id",
        "snapshot_id",
        "step_id",
        "verification_spec_id",
        "rationale",
        "operations"
      ],
      "properties": {
        "kind": {
          "const": "apply_patch"
        },
        "run_id": {
          "$ref": "#/$defs/hexId"
        },
        "worktree_id": {
          "$ref": "#/$defs/hexId"
        },
        "snapshot_id": {
          "$ref": "#/$defs/hexId"
        },
        "step_id": {
          "$ref": "#/$defs/stepId"
        },
        "verification_spec_id": {
          "$ref": "#/$defs/hexId"
        },
        "rationale": {
          "$ref": "#/$defs/path"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/patchAdd"
              },
              {
                "$ref": "#/$defs/patchUpdate"
              },
              {
                "$ref": "#/$defs/patchMove"
              },
              {
                "$ref": "#/$defs/patchDelete"
              }
            ]
          }
        }
      }
    },
    "patchAdd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "content"
      ],
      "properties": {
        "kind": {
          "const": "add"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "content": {
          "type": "string",
          "maxLength": 4194304
        }
      }
    },
    "patchUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "expected_hash",
        "content"
      ],
      "properties": {
        "kind": {
          "const": "update"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "expected_hash": {
          "$ref": "#/$defs/hexId"
        },
        "content": {
          "type": "string",
          "maxLength": 4194304
        }
      }
    },
    "patchMove": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "expected_hash",
        "destination"
      ],
      "properties": {
        "kind": {
          "const": "move"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "expected_hash": {
          "$ref": "#/$defs/hexId"
        },
        "destination": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "patchDelete": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "expected_hash"
      ],
      "properties": {
        "kind": {
          "const": "delete"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "expected_hash": {
          "$ref": "#/$defs/hexId"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "step_id",
        "command_id"
      ],
      "properties": {
        "kind": {
          "const": "run"
        },
        "step_id": {
          "$ref": "#/$defs/stepId"
        },
        "command_id": {
          "$ref": "#/$defs/hexId"
        }
      }
    },
    "functionFlowTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "symbol_id",
        "call_path",
        "view"
      ],
      "properties": {
        "kind": {
          "const": "function_flow"
        },
        "symbol_id": {
          "$ref": "#/$defs/hexId"
        },
        "call_path": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          }
        },
        "view": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "offset"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "steps",
                    "values"
                  ]
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4050,
                  "multipleOf": 50
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "value"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "origins",
                    "uses"
                  ]
                },
                "value": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4096
                }
              }
            }
          ]
        }
      }
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "tool"
      ],
      "properties": {
        "kind": {
          "const": "machine"
        },
        "tool": {
          "oneOf": [
            {
              "$ref": "#/$defs/machineFile"
            },
            {
              "$ref": "#/$defs/machineProcess"
            },
            {
              "$ref": "#/$defs/machineHttpGet"
            }
          ]
        }
      }
    },
    "machineFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "version",
        "step_id",
        "path",
        "operation"
      ],
      "properties": {
        "kind": {
          "const": "file"
        },
        "version": {
          "const": 1
        },
        "step_id": {
          "$ref": "#/$defs/stepId"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "operation": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "expected_hash"
              ],
              "properties": {
                "kind": {
                  "const": "read"
                },
                "expected_hash": {
                  "$ref": "#/$defs/optionalHash"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "expected_hash",
                "content"
              ],
              "properties": {
                "kind": {
                  "const": "write"
                },
                "expected_hash": {
                  "$ref": "#/$defs/optionalHash"
                },
                "content": {
                  "type": "string",
                  "maxLength": 65536
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "expected_hash"
              ],
              "properties": {
                "kind": {
                  "const": "delete"
                },
                "expected_hash": {
                  "$ref": "#/$defs/hexId"
                }
              }
            }
          ]
        }
      }
    },
    "machineProcess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "version",
        "step_id",
        "program",
        "args"
      ],
      "properties": {
        "kind": {
          "const": "process"
        },
        "version": {
          "const": 1
        },
        "step_id": {
          "$ref": "#/$defs/stepId"
        },
        "program": {
          "$ref": "#/$defs/path"
        },
        "args": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        }
      }
    },
    "machineHttpGet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "version",
        "step_id",
        "url"
      ],
      "properties": {
        "kind": {
          "const": "http_get"
        },
        "version": {
          "const": 1
        },
        "step_id": {
          "$ref": "#/$defs/stepId"
        },
        "url": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "stepId": {
      "$ref": "#/$defs/hexId"
    },
    "optionalHash": {
      "anyOf": [
        {
          "$ref": "#/$defs/hexId"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
