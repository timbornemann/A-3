{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a3.local/schemas/agent-action-v4.schema.json",
  "title": "A^3 AgentAction V4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "public_note",
    "action"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "public_note": {
      "$ref": "#/$defs/publicNote"
    },
    "action": {
      "oneOf": [
        {
          "$ref": "#/$defs/search"
        },
        {
          "$ref": "#/$defs/inspect"
        },
        {
          "$ref": "#/$defs/updateLedger"
        },
        {
          "$ref": "#/$defs/finish"
        },
        {
          "$ref": "#/$defs/applyPatch"
        },
        {
          "$ref": "#/$defs/run"
        }
      ]
    }
  },
  "$defs": {
    "publicNote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "finding_kind",
        "finding",
        "finding_source_refs",
        "gap",
        "next_step"
      ],
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "finding_kind": {
          "enum": [
            "observation",
            "hypothesis",
            "conclusion"
          ]
        },
        "finding": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "finding_source_refs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^S(?:[1-9]|[1-9][0-9]|1[0-9]{2}|200)$"
          }
        },
        "gap": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "next_step": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "hexId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "query",
        "limit"
      ],
      "properties": {
        "kind": {
          "const": "search"
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "inspect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target"
      ],
      "properties": {
        "kind": {
          "const": "inspect"
        },
        "target": {
          "oneOf": [
            {
              "$ref": "#/$defs/fileTarget"
            },
            {
              "$ref": "#/$defs/symbolTarget"
            },
            {
              "$ref": "#/$defs/graphTarget"
            },
            {
              "$ref": "#/$defs/claimTarget"
            },
            {
              "$ref": "#/$defs/testTarget"
            },
            {
              "$ref": "#/$defs/functionFlowTarget"
            }
          ]
        }
      }
    },
    "fileTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "start_line",
        "line_count"
      ],
      "properties": {
        "kind": {
          "const": "file"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "line_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      }
    },
    "symbolTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "symbol_id"
      ],
      "properties": {
        "kind": {
          "const": "symbol"
        },
        "symbol_id": {
          "$ref": "#/$defs/hexId"
        }
      }
    },
    "graphTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "symbol_id",
        "direction",
        "relation",
        "depth",
        "limit"
      ],
      "properties": {
        "kind": {
          "const": "graph"
        },
        "symbol_id": {
          "$ref": "#/$defs/hexId"
        },
        "direction": {
          "enum": [
            "outgoing",
            "incoming"
          ]
        },
        "relation": {
          "enum": [
            "imports",
            "exports",
            "calls",
            "tests"
          ]
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "claimTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "claim_id"
      ],
      "properties": {
        "kind": {
          "const": "claim"
        },
        "claim_id": {
          "$ref": "#/$defs/hexId"
        }
      }
    },
    "testTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "selector"
      ],
      "properties": {
        "kind": {
          "const": "test"
        },
        "selector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "updateLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "step_id",
        "update"
      ],
      "properties": {
        "kind": {
          "const": "update_ledger"
        },
        "step_id": {
          "$ref": "#/$defs/hexId"
        },
        "update": {
          "oneOf": [
            {
              "$ref": "#/$defs/recordResult"
            },
            {
              "$ref": "#/$defs/reportBlocked"
            },
            {
              "$ref": "#/$defs/requestReplan"
            }
          ]
        }
      }
    },
    "recordResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "summary"
      ],
      "properties": {
        "kind": {
          "const": "record_result"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      }
    },
    "reportBlocked": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reason"
      ],
      "properties": {
        "kind": {
          "const": "report_blocked"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "requestReplan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reason"
      ],
      "properties": {
        "kind": {
          "const": "request_replan"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "finish": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "finish"
        }
      }
    },
    "applyPatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "run_id",
        "worktree_id",
        "snapshot_id",
        "step_id",
        "verification_spec_id",
        "rationale",
        "operations"
      ],
      "properties": {
        "kind": {
          "const": "apply_patch"
        },
        "run_id": {
          "$ref": "#/$defs/hexId"
        },
        "worktree_id": {
          "$ref": "#/$defs/hexId"
        },
        "snapshot_id": {
          "$ref": "#/$defs/hexId"
        },
        "step_id": {
          "$ref": "#/$defs/hexId"
        },
        "verification_spec_id": {
          "$ref": "#/$defs/hexId"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/patchAdd"
              },
              {
                "$ref": "#/$defs/patchUpdate"
              },
              {
                "$ref": "#/$defs/patchMove"
              },
              {
                "$ref": "#/$defs/patchDelete"
              }
            ]
          }
        }
      }
    },
    "patchAdd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "content"
      ],
      "properties": {
        "kind": {
          "const": "add"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "content": {
          "type": "string",
          "maxLength": 4194304
        }
      }
    },
    "patchUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "expected_hash",
        "content"
      ],
      "properties": {
        "kind": {
          "const": "update"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "expected_hash": {
          "$ref": "#/$defs/hexId"
        },
        "content": {
          "type": "string",
          "maxLength": 4194304
        }
      }
    },
    "patchMove": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "expected_hash",
        "destination"
      ],
      "properties": {
        "kind": {
          "const": "move"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "expected_hash": {
          "$ref": "#/$defs/hexId"
        },
        "destination": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "patchDelete": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "expected_hash"
      ],
      "properties": {
        "kind": {
          "const": "delete"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "expected_hash": {
          "$ref": "#/$defs/hexId"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "step_id",
        "command_id"
      ],
      "properties": {
        "kind": {
          "const": "run"
        },
        "step_id": {
          "$ref": "#/$defs/hexId"
        },
        "command_id": {
          "$ref": "#/$defs/hexId"
        }
      }
    },
    "functionFlowTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "symbol_id",
        "call_path",
        "view"
      ],
      "properties": {
        "kind": {
          "const": "function_flow"
        },
        "symbol_id": {
          "$ref": "#/$defs/hexId"
        },
        "call_path": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          }
        },
        "view": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "offset"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "steps",
                    "values"
                  ]
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4050,
                  "multipleOf": 50
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "value"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "origins",
                    "uses"
                  ]
                },
                "value": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4096
                }
              }
            }
          ]
        }
      }
    }
  }
}
