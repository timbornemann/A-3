{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision"],
  "properties": {
    "schema_version": { "const": 2 },
    "decision": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "note", "markdown", "source_refs"],
          "properties": {
            "kind": { "const": "answer" },
            "note": { "$ref": "#/$defs/note" },
            "markdown": { "type": "string", "minLength": 1, "maxLength": 262144 },
            "source_refs": { "$ref": "#/$defs/sourceRefs" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "note", "actions"],
          "properties": {
            "kind": { "const": "research" },
            "note": { "$ref": "#/$defs/note" },
            "actions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": { "$ref": "#/$defs/action" }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "string",
      "pattern": "^S(?:[1-9]|[1-9][0-9]|1[0-9][0-9]|200)$"
    },
    "sourceRefs": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sourceRef" }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "finding_kind", "finding", "finding_source_refs", "gap", "next_step"],
      "properties": {
        "goal": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "finding_kind": { "enum": ["observation", "hypothesis", "conclusion"] },
        "finding": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "finding_source_refs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceRef" }
        },
        "gap": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "next_step": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "query"],
          "properties": {
            "kind": { "const": "searchIndex" },
            "query": { "type": "string", "minLength": 1, "maxLength": 4096 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "literals"],
          "properties": {
            "kind": { "const": "searchSourceText" },
            "literals": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 256 }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "inspectPath" },
            "path": { "type": "string", "minLength": 1, "maxLength": 4096 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "source_ref"],
          "properties": {
            "kind": { "const": "inspectSource" },
            "source_ref": { "$ref": "#/$defs/sourceRef" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "source_ref", "relation"],
          "properties": {
            "kind": { "const": "inspectRelations" },
            "source_ref": { "$ref": "#/$defs/sourceRef" },
            "relation": { "enum": ["callers", "callees", "imports", "exports", "tests"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "listDirectory" },
            "path": { "type": "string", "maxLength": 4096 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "inspectWorkingChanges" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "queryIndexDiagnostics" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "inspectDependencyGraph" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "inspectTestTopology" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "scanSecurityCandidates" } }
        }
      ]
    }
  }
}
